# Database Configuration
POSTGRES_USER=oceanembed
POSTGRES_PASSWORD=oceanembed_dev
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=oceanembed
DATABASE_URL=postgresql+asyncpg://oceanembed:oceanembed_dev@db:5432/oceanembed

# Backend Data Configuration
